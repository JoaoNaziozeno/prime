APP_NAME="Prime ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Localization
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Cache & Maintenance
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== DATABASE MASTER =====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prime_master
DB_USERNAME=root
DB_PASSWORD=

# ===== SESSIONS =====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ===== BROADCAST =====
BROADCAST_CONNECTION=log

# ===== FILESYSTEM =====
FILESYSTEM_DISK=local
# Para MinIO S3:
# FILESYSTEM_DISK=s3

# ===== QUEUE =====
QUEUE_CONNECTION=redis

# ===== CACHE =====
CACHE_STORE=redis
# CACHE_PREFIX=prime_

# ===== REDIS =====
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== MAIL =====
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@prime-erp.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===== S3 / MinIO =====
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=prime
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ===== SANCTUM =====
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SANCTUM_DOMAIN=localhost

# ===== TENANCY =====
TENANT_DRIVER=mysql

# ===== VITE =====
VITE_APP_NAME="${APP_NAME}"
